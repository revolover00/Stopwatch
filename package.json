{
  "name": "splitdeck-flip-clock-suite",
  "private": true,
  "version": "1.0.0",
  "description": "Responsive split-flap clock, study focus timer, countdown, stopwatch, and alarm web suite built with Vite, React, TypeScript, and Tailwind CSS.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:single": "vite build --mode singlefile --outDir dist-single",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@ncdai/react-wheel-picker": "^1.2.3",
    "howler": "^2.2.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snd-lib": "^1.2.4"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.0.2"
  }
}
